---
# Credenciais do bot do Telegram para as notificações do Netdata.
#
# Uso: copie para secrets.yml (mesmo diretório) e preencha com os valores reais.
#   cp secrets.yml.example secrets.yml
# O secrets.yml é ignorado pelo git e carregado automaticamente pelo playbook.
#
# Como obter: token via @BotFather (/newbot); chat_id via @userinfobot.

telegram_bot_token: "123456789:AAAA-exemplo-de-token-substitua-pelo-seu"
telegram_chat_id: "123456789"
